# =============================================================================
# Wazuh SIEM — Environment Variables
# Copy to .env and set real values before deploying on Dokploy.
# =============================================================================

# Wazuh version (all 3 images use the same tag)
WAZUH_VERSION=4.14.6

# --- Ports ---
# Manager agent communication
MANAGER_PORT_1514=1514
# Manager agent enrollment
MANAGER_PORT_1515=1515
# Manager syslog
MANAGER_PORT_514=514
# Manager REST API
MANAGER_PORT_55000=55000
# Indexer API
INDEXER_PORT=9200
# Dashboard web UI (external port)
DASHBOARD_PORT=443

# --- Credentials ---
# Indexer (OpenSearch) admin — used by all 3 containers
INDEXER_USERNAME=admin
INDEXER_PASSWORD=CHANGE_ME_STRONG_PASSWORD

# Wazuh API user — manager + dashboard
API_USERNAME=wazuh-wui
API_PASSWORD=CHANGE_ME_STRONG_PASSWORD

# Dashboard internal user — dashboard container only
DASHBOARD_USERNAME=kibanaserver
DASHBOARD_PASSWORD=CHANGE_ME_STRONG_PASSWORD

# --- Indexer JVM Heap ---
# Set to half available RAM, max 31g
OPENSEARCH_JAVA_OPTS=-Xms1g -Xmx1g
